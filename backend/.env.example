SERVICE_NAME=backend
ENVIRONMENT=local
API_PREFIX=/api
DATA_DIR=data

# Database connection (DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME) is read from
# the repo root .env, not from this file — see ../.env.example. Only set DATABASE_URL
# here if you need to point this backend at a different database than the one used by
# infra/docker/docker-compose.yml.
