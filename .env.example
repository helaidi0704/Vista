# ========================
# VISTA — Docker Compose environment variables
# ========================
# This is the single source of truth for local DB/port config: it drives both the
# full Docker stack (infra/docker/docker-compose.yml) and the backend when it runs
# bare-metal (backend/app/core/config.py). Copy to .env and adjust freely per
# developer machine — .env is gitignored.

# PostgreSQL / backend DB connection (docker-compose.yml maps these onto the
# POSTGRES_* names required by the postgres image itself — only DB_* needs setting)
DB_HOST=localhost
DB_PORT=5442
DB_USER=vista
DB_PASSWORD=vista
DB_NAME=vista

# Backend API (host port published by docker-compose; 8001 to avoid clashing
# with other local services that squat 8000)
API_PORT=8001

# Frontend (host port published by docker-compose; 4201 to avoid clashing
# with other local services that squat 4200)
UI_PORT=4201
